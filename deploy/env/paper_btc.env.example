# Copy this file to: /opt/trading-bot/deploy/env/paper_btc.env
# Then set file permissions: chmod 600 /opt/trading-bot/deploy/env/paper_btc.env

CAPITAL_BASE_URL=https://demo-api-capital.backend-capital.com/api/v1
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
CAPITAL_ACCOUNT_ID=

CAPITAL_EPIC=BTCUSD
CAPITAL_TRADE_EPICS=BTCUSD
CAPITAL_WATCH_EPICS=

SQLITE_PATH=/opt/trading-bot/state/bot_state_paper_btc.db
DASHBOARD_PATH=/opt/trading-bot/runtime/dashboard_btc.json
CONFIG_PATH=config.yaml
RETENTION_DAYS=14
BACKUP_VERIFY_ON_CREATE=true
SOAK_SINCE_HOURS=24
