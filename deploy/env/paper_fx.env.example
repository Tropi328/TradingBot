# Copy this file to: /opt/trading-bot/deploy/env/paper_fx.env
# Then set file permissions: chmod 600 /opt/trading-bot/deploy/env/paper_fx.env

CAPITAL_BASE_URL=https://demo-api-capital.backend-capital.com/api/v1
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
CAPITAL_ACCOUNT_ID=

CAPITAL_EPIC=GOLD
CAPITAL_TRADE_EPICS=GOLD,EURUSD,US100,US500
CAPITAL_WATCH_EPICS=

SQLITE_PATH=/opt/trading-bot/state/bot_state_paper_fx.db
DASHBOARD_PATH=/opt/trading-bot/runtime/dashboard_fx.json
CONFIG_PATH=config.yaml
RETENTION_DAYS=14
BACKUP_VERIFY_ON_CREATE=true

ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO
